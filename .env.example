# Copia este archivo como .env.local y rellena los valores. .env.local no se sube a Git.

# Neon → tu proyecto → Connect → cadena de conexión (con ?sslmode=require)
DATABASE_URL=

# Secreto de sesiones: genera uno con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL pública de la app (en Vercel se pone la del dominio)
BETTER_AUTH_URL=http://localhost:3000

# Primer usuario administrador que crea `pnpm db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Imágenes en Cloudflare R2 (opcional en local: sin esto se guardan en public/uploads).
# Obligatorio en Vercel. Cloudflare → R2 → crear bucket y un token de API con permiso de escritura.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket (dominio propio o https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# Secreto para la tarea que publica las notas programadas: `openssl rand -base64 32`
CRON_SECRET=
