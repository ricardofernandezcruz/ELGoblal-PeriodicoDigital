# Copia este archivo como .env.local y rellena los valores. .env.local no se sube a Git.

# Neon → tu proyecto → Connect → cadena de conexión (con ?sslmode=require)
DATABASE_URL=

# Secreto de sesiones: genera uno con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL pública de la app (en Vercel se pone la del dominio)
BETTER_AUTH_URL=http://localhost:3000

# Primer usuario administrador que crea `pnpm db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Imágenes en Cloudflare R2 (opcional en local: sin esto se guardan en public/uploads).
# Obligatorio en Vercel. Cloudflare → R2 → crear bucket y un token de API con permiso de escritura.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket (dominio propio o https://pub-xxxx.r2.dev).
# Para pasar a un dominio propio: pnpm media:dominio https://pub-xxxx.r2.dev https://media.tudominio.com
R2_PUBLIC_URL=

# Secreto para la tarea que publica las notas programadas: `openssl rand -base64 32`
CRON_SECRET=

# Dominio público del sitio para los enlaces de los correos (sin barra final). En Vercel, si falta,
# se usa la URL de producción del proyecto.
SITE_URL=

# Correo con Resend (resend.com → API Keys). Sin esto, en local los correos salen en la consola.
# EMAIL_FROM debe ser de un dominio verificado en Resend, p. ej. "El Global <boletin@tudominio.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Opcional: firma de los enlaces del boletín (confirmar / darse de baja). Si falta, usa BETTER_AUTH_SECRET.
NEWSLETTER_SECRET=

# Avisos de última hora (Web Push). Se generan una sola vez con:
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"
# Si cambian, los lectores tienen que volver a activar los avisos.
VAPID_SUBJECT=mailto:redaccion@tudominio.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
